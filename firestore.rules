rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Préférences de chaque compte (catégories de confidences).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["categories", "updatedAt"])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 50;
      allow delete: if false;
    }

    match /presentations/{presentationId} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;

      // Owners can update anything (except transferring ownership).
      // Anyone with the link can bump the public view counter only — needed
      // because readers of a shared confidence are never authenticated.
      allow update: if (request.auth != null
          && request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewCount"]);

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      // Une consultation = date, type d'appareil, progression et durée.
      // Aucune donnée personnelle (ni IP, ni identifiant) n'est stockée.
      match /views/{viewId} {
        allow create: if request.resource.data.keys().hasOnly([
              "viewedAt", "lastActiveAt", "device", "slideCount", "maxSlide", "completed", "durationMs"])
          && request.resource.data.viewedAt == request.time
          && request.resource.data.lastActiveAt == request.time
          && request.resource.data.device in ["mobile", "tablette", "ordinateur"]
          && request.resource.data.slideCount is int
          && request.resource.data.slideCount >= 1
          && request.resource.data.slideCount <= 500
          && request.resource.data.maxSlide == 1
          && request.resource.data.completed is bool
          && request.resource.data.durationMs == 0;

        // Le lecteur fait seulement avancer sa progression et sa durée, et
        // peut laisser un avis : une note de 1 à 5 et un commentaire facultatif.
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["maxSlide", "completed", "durationMs", "lastActiveAt", "rating", "comment", "feedbackAt"])
          && (!("rating" in request.resource.data)
              || (request.resource.data.rating is int
                  && request.resource.data.rating >= 1
                  && request.resource.data.rating <= 5))
          && (!("comment" in request.resource.data)
              || (request.resource.data.comment is string
                  && request.resource.data.comment.size() <= 1000))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["feedbackAt"])
              || request.resource.data.feedbackAt == request.time)
          && request.resource.data.lastActiveAt == request.time
          && request.resource.data.maxSlide is int
          && request.resource.data.maxSlide >= resource.data.maxSlide
          && request.resource.data.maxSlide <= resource.data.slideCount
          && request.resource.data.completed == (request.resource.data.maxSlide == resource.data.slideCount)
          && request.resource.data.durationMs is int
          && request.resource.data.durationMs >= resource.data.durationMs
          && request.resource.data.durationMs <= 86400000;

        // Le propriétaire consulte l'historique et le supprime avec la confidence.
        allow read, list, delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/presentations/$(presentationId)).data.ownerId;
      }
    }
  }
}
